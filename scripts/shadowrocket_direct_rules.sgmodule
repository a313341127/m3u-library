#!name=秦哥影视国内CDN直连
#!desc=强制量子/茅台/暴风/bfvvs/文采等国内视频CDN走DIRECT，配合配置模式使用

[Rule]
# ===========================================================
# 秦哥影视 / 途播 - 国内视频 CDN 直连规则 (Shadowrocket)
# 用途：手机开 VPN 访问 qinjin.pages.dev 后端的同时，
#        让国内视频 CDN 走本地直连（不被 VPN 代理拦截）。
# 用法：Shadowrocket -> 配置 -> 右上角 + -> 导入/添加规则
#        把下面每行作为一条规则；或整体存成 .list 文件订阅。
# 关键：出站模式必须选「配置」而非「全局代理」，
#        且 DNS 用国内解析（223.5.5.5 / 119.29.29.29）。
# ===========================================================
# ---- 文采 WenCai 播放链（强制直连，最关键）----
DOMAIN-SUFFIX,ppvod01.6g9ba6.com,DIRECT
DOMAIN-SUFFIX,6g9ba6.com,DIRECT
DOMAIN-SUFFIX,play.hhuus.com,DIRECT
DOMAIN-SUFFIX,hhuus.com,DIRECT
DOMAIN-SUFFIX,hhwenjian.com,DIRECT
DOMAIN-SUFFIX,p.hhwenjian.com,DIRECT
